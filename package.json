{
  "name": "@stagas/wasm-sourcemap",
  "author": "stagas",
  "version": "1.0.1",
  "description": "Fix AssemblyScript generated wasm binary sourcemaps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stagas/wasm-sourcemap.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "echo ok",
    "build": "tsdown",
    "check:pkg": "publint && attw --pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^24.12.4",
    "publint": "^0.3.21",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
